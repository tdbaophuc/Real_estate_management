# Copy this file to .env before starting Docker Compose.
DB_NAME=Real_estate_management_dev
DB_USERNAME=postgres
DB_PASSWORD=change-me-local
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/Real_estate_management_dev

JWT_SECRET=

REDIS_PORT=6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-local
MINIO_BUCKET=real-estate
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Storage provider. Use "local" for dev/test, or "r2" for Cloudflare R2.
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./var/storage
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_SIGNED_URL_TTL=PT15M
MAX_UPLOAD_SIZE=10MB

MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

AI_ENABLED=true
AI_PROVIDER=openai
AI_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_OPENAI_KEY=
AI_LLM_MODEL=gpt-4o-mini
# Backward-compatible aliases. Prefer the OpenAI-specific variables above.
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=PT10S
