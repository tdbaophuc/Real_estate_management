{
  "info": {
    "_postman_id": "4f1a1a4a-0bb1-4df5-a3c5-main-flow",
    "name": "Real Estate Management - Main API Flow",
    "description": "Postman Collection kiem thu luong API chinh: auth, admin user provisioning, master data, customer, lead, property, listing, public search, appointment, dashboard, reports, notifications va AI chat. Import file nay vao Postman; neu Postman khong nhan do duoi .md, doi ten file thanh POSTMAN_MAIN_FLOW.postman_collection.json.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runSuffix')) {",
          "  pm.collectionVariables.set('runSuffix', Date.now().toString());",
          "}",
          "const now = Date.now();",
          "pm.collectionVariables.set('futureStartAt', new Date(now + 24 * 60 * 60 * 1000).toISOString());",
          "pm.collectionVariables.set('futureEndAt', new Date(now + 25 * 60 * 60 * 1000).toISOString());",
          "pm.collectionVariables.set('preferredStartAt', new Date(now + 26 * 60 * 60 * 1000).toISOString());",
          "pm.collectionVariables.set('preferredEndAt', new Date(now + 27 * 60 * 60 * 1000).toISOString());",
          "pm.collectionVariables.set('today', new Date(now).toISOString().slice(0, 10));",
          "pm.collectionVariables.set('nextMonth', new Date(now + 30 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminEmail",
      "value": "admin@realestate.local"
    },
    {
      "key": "adminPassword",
      "value": "StrongDevPassword123!"
    },
    {
      "key": "managerPassword",
      "value": "Manager@12345"
    },
    {
      "key": "agentPassword",
      "value": "Agent@12345"
    },
    {
      "key": "ownerPassword",
      "value": "Owner@12345"
    }
  ],
